 ],
 "categories": [
  {
   "id": "free-fire.sensitivity",
   "schema_id": "free-fire",
   "label": "Sensitivity",
   "description": "In game: Settings → Sensitivity. Every slider runs from 0 to 200 — higher turns the camera faster for the same swipe.",
   "display_order": 1,
   "requires_gyro": false
  },
  {
   "id": "pubg-family.camera",
   "schema_id": "pubg-family",
   "label": "Camera",
   "description": "In game: Settings → Sensitivity → Camera Sensitivity. Swipe speed when you are NOT firing — turning, checking corners and lining up a shot.",
   "display_order": 1,
   "requires_gyro": false
  },
  {
   "id": "pubg-family.ads",
   "schema_id": "pubg-family",
   "label": "ADS",
   "description": "In game: Settings → Sensitivity → ADS Sensitivity. Swipe speed WHILE firing. This is what you pull down against recoil, so it matters most for sprays.",
   "display_order": 2,
   "requires_gyro": false
  },
  {
   "id": "pubg-family.gyro",
   "schema_id": "pubg-family",
   "label": "Gyroscope",
   "description": "In game: Settings → Sensitivity → Gyroscope Sensitivity. How far the view moves when you tilt the phone. Works only with Gyroscope set to Scope On or Always On.",
   "display_order": 3,
   "requires_gyro": true
  },
  {
   "id": "pubg-family.ads-gyro",
   "schema_id": "pubg-family",
   "label": "ADS Gyroscope",
   "description": "In game: Settings → Sensitivity → ADS Gyroscope Sensitivity. Tilt speed WHILE firing — gyro players tilt the phone down to control recoil.",
   "display_order": 4,
   "requires_gyro": true
  },
  {
   "id": "pubg-family.free-look",
   "schema_id": "pubg-family",
   "label": "Free Look",
   "description": "In game: Settings → Sensitivity → Camera Sensitivity (Free Look). Moves only the camera while you hold the eye button — your aim stays put. Tune it for comfortable looking around.",
   "display_order": 5,
   "requires_gyro": false
  }
 ],
