rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'tusharkantidasofficial@gmail.com'
      );
    }

    function isNullableString(val, minLen, maxLen) {
      return val == null || (val is string && val.size() >= minLen && val.size() <= maxLen);
    }

    function isNullableNumber(val, minVal, maxVal) {
      return val == null || (val is number && val >= minVal && val <= maxVal);
    }

    function isValidGame(game) {
      return game in ['free-fire', 'pubg-bgmi'];
    }

    function isValidCompatGameKey(gameKey) {
      return gameKey in ['free-fire', 'free-fire-max', 'bgmi', 'pubg-mobile'];
    }

    function isValidClaw(claw) {
      return claw in ['2-finger', '3-finger', '4-finger', '5-finger', '6-finger'];
    }

    function isValidPlaystyle(playstyle) {
      return playstyle in [
        'aggressive-rush',
        'headshot-focus',
        'balanced',
        'sniper-focus',
        'aggressive',
        'tactical'
      ];
    }

    function isValidGyro(gyro) {
      return gyro in ['off', 'scope-on', 'always-on'];
    }

    function isValidOs(os) {
      return os in ['Android', 'iOS', 'HarmonyOS'];
    }

    function isValidSmartphoneOs(os) {
      return os in ['Android', 'iOS', 'HarmonyOS'];
    }

    function isValidTier(tier) {
      return tier in ['Flagship', 'Esports', 'Mid-Range', 'Budget', 'Tablet'];
    }

    function isValidSmartphoneTier(tier) {
      return tier in ['Flagship', 'Esports', 'Mid-Range', 'Budget'];
    }

    function isValidGyroSupport(val) {
      return val in ['hardware', 'software', 'none', 'unknown'];
    }

    function isValidDeviceMap(device) {
      return device is map &&
        device.keys().hasAll([
          'id', 'brand', 'model', 'os', 'chipset',
          'ramGb', 'storageGb', 'screenInches', 'resolution',
          'refreshHz', 'touchSamplingHz', 'tier'
        ]) &&
        device.keys().hasOnly([
          'id', 'brand', 'model', 'os', 'chipset',
          'ramGb', 'storageGb', 'screenInches', 'resolution',
          'refreshHz', 'touchSamplingHz', 'tier'
        ]) &&
        isValidId(device.id) &&
        device.brand is string && device.brand.size() >= 1 && device.brand.size() <= 60 &&
        device.model is string && device.model.size() >= 1 && device.model.size() <= 80 &&
        isValidOs(device.os) &&
        device.chipset is string && device.chipset.size() >= 1 && device.chipset.size() <= 80 &&
        device.ramGb is number && device.ramGb >= 1 && device.ramGb <= 64 &&
        device.storageGb is number && device.storageGb >= 16 && device.storageGb <= 4096 &&
        device.screenInches is number && device.screenInches >= 4.5 && device.screenInches <= 14.0 &&
        device.resolution is string && device.resolution.size() >= 1 && device.resolution.size() <= 40 &&
        device.refreshHz is number && device.refreshHz >= 60 && device.refreshHz <= 240 &&
        device.touchSamplingHz is number && device.touchSamplingHz >= 60 && device.touchSamplingHz <= 3000 &&
        isValidTier(device.tier);
    }

    function isValidDisplayMap(display) {
      return display is map &&
        display.keys().hasAll([
          'sizeInches', 'panelType', 'resolution', 'refreshHz',
          'touchSamplingHz', 'peakBrightnessNits'
        ]) &&
        display.keys().hasOnly([
          'sizeInches', 'panelType', 'resolution', 'refreshHz',
          'touchSamplingHz', 'peakBrightnessNits'
        ]) &&
        display.sizeInches is number && display.sizeInches >= 4.5 && display.sizeInches <= 8.5 &&
        isNullableString(display.panelType, 1, 80) &&
        display.resolution is string && display.resolution.size() >= 1 && display.resolution.size() <= 40 &&
        display.refreshHz is number && display.refreshHz >= 60 && display.refreshHz <= 240 &&
        isNullableNumber(display.touchSamplingHz, 60, 3000) &&
        isNullableNumber(display.peakBrightnessNits, 100, 10000);
    }

    function isValidSourceEntry(source) {
      return source is map &&
        source.keys().hasAll(['title', 'url']) &&
        source.keys().hasOnly(['title', 'url']) &&
        source.title is string && source.title.size() >= 1 && source.title.size() <= 120 &&
        source.url is string && source.url.size() >= 1 && source.url.size() <= 300;
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.role == 'player' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedSetup(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'game', 'device', 'claw',
          'playstyle', 'gyro', 'preferredFps', 'sliders', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'game', 'device', 'claw',
          'playstyle', 'gyro', 'preferredFps', 'fireButtonSize',
          'dpiOverride', 'cameraPref', 'currentSensitivity',
          'sliders', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        isValidGame(data.game) &&
        isValidDeviceMap(data.device) &&
        isValidClaw(data.claw) &&
        isValidPlaystyle(data.playstyle) &&
        isValidGyro(data.gyro) &&
        data.preferredFps is string && data.preferredFps.size() >= 1 && data.preferredFps.size() <= 40 &&
        (!('fireButtonSize' in data) || (data.fireButtonSize is number && data.fireButtonSize >= 30 && data.fireButtonSize <= 80)) &&
        (!('dpiOverride' in data) || (data.dpiOverride is string && data.dpiOverride.size() <= 16)) &&
        (!('cameraPref' in data) || data.cameraPref in ['low', 'medium', 'high']) &&
        (!('currentSensitivity' in data) || (data.currentSensitivity is string && data.currentSensitivity.size() <= 160)) &&
        data.sliders is map && data.sliders.size() >= 1 && data.sliders.size() <= 24 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomDevice(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'brand', 'model', 'os', 'chipset',
          'ramGb', 'storageGb', 'screenInches', 'resolution',
          'refreshHz', 'touchSamplingHz', 'tier', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'brand', 'model', 'os', 'chipset',
          'ramGb', 'storageGb', 'screenInches', 'resolution',
          'refreshHz', 'touchSamplingHz', 'tier', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60 &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 80 &&
        isValidOs(data.os) &&
        data.chipset is string && data.chipset.size() >= 1 && data.chipset.size() <= 80 &&
        data.ramGb is number && data.ramGb >= 1 && data.ramGb <= 64 &&
        data.storageGb is number && data.storageGb >= 16 && data.storageGb <= 4096 &&
        data.screenInches is number && data.screenInches >= 4.5 && data.screenInches <= 14.0 &&
        data.resolution is string && data.resolution.size() >= 1 && data.resolution.size() <= 40 &&
        data.refreshHz is number && data.refreshHz >= 60 && data.refreshHz <= 240 &&
        data.touchSamplingHz is number && data.touchSamplingHz >= 60 && data.touchSamplingHz <= 3000 &&
        isValidTier(data.tier) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAimLabRun(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'game', 'hits', 'misses',
          'accuracy', 'bestStreak', 'scalar', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'game', 'hits', 'misses',
          'accuracy', 'avgReactionMs', 'bestStreak', 'scalar', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidGame(data.game) &&
        data.hits is number && data.hits >= 0 && data.hits <= 500 &&
        data.misses is number && data.misses >= 0 && data.misses <= 500 &&
        data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
        (!('avgReactionMs' in data) || (data.avgReactionMs is number && data.avgReactionMs >= 0 && data.avgReactionMs <= 15000)) &&
        data.bestStreak is number && data.bestStreak >= 0 && data.bestStreak <= 500 &&
        data.scalar is number && data.scalar >= 0.5 && data.scalar <= 2.0 &&
        data.createdAt is timestamp;
    }

    function isValidPreset(data) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'visibility', 'name', 'playerArchetype',
          'game', 'claw', 'playstyle', 'gyro', 'deviceBrand', 'deviceModel',
          'deviceChipset', 'deviceOs', 'deviceScreenInches', 'deviceRefreshHz',
          'deviceRamGb', 'deviceStorageGb', 'deviceResolution', 'headlineMetric',
          'description', 'sliders', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'visibility', 'name', 'playerArchetype',
          'game', 'claw', 'playstyle', 'gyro', 'deviceBrand', 'deviceModel',
          'deviceChipset', 'deviceOs', 'deviceScreenInches', 'deviceRefreshHz',
          'deviceRamGb', 'deviceStorageGb', 'deviceResolution', 'headlineMetric',
          'description', 'sliders', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.visibility == 'public' &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.playerArchetype is string && data.playerArchetype.size() >= 1 && data.playerArchetype.size() <= 60 &&
        isValidGame(data.game) &&
        isValidClaw(data.claw) &&
        isValidPlaystyle(data.playstyle) &&
        isValidGyro(data.gyro) &&
        data.deviceBrand is string && data.deviceBrand.size() >= 1 && data.deviceBrand.size() <= 60 &&
        data.deviceModel is string && data.deviceModel.size() >= 1 && data.deviceModel.size() <= 80 &&
        data.deviceChipset is string && data.deviceChipset.size() >= 1 && data.deviceChipset.size() <= 80 &&
        isValidOs(data.deviceOs) &&
        data.deviceScreenInches is number && data.deviceScreenInches >= 4.5 && data.deviceScreenInches <= 14.0 &&
        data.deviceRefreshHz is number && data.deviceRefreshHz >= 60 && data.deviceRefreshHz <= 240 &&
        data.deviceRamGb is number && data.deviceRamGb >= 1 && data.deviceRamGb <= 64 &&
        data.deviceStorageGb is number && data.deviceStorageGb >= 16 && data.deviceStorageGb <= 4096 &&
        data.deviceResolution is string && data.deviceResolution.size() >= 1 && data.deviceResolution.size() <= 40 &&
        data.headlineMetric is string && data.headlineMetric.size() >= 1 && data.headlineMetric.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
        data.sliders is map && data.sliders.size() >= 1 && data.sliders.size() <= 24 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBrand(data) {
      return data.keys().hasAll([
          'id', 'visibility', 'name', 'parentCompany', 'country',
          'isSubBrand', 'deviceCount', 'latestReleaseYear', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'visibility', 'name', 'parentCompany', 'country',
          'isSubBrand', 'deviceCount', 'latestReleaseYear', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visibility == 'public' &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        isNullableString(data.parentCompany, 1, 80) &&
        data.country is string && data.country.size() >= 1 && data.country.size() <= 60 &&
        data.isSubBrand is bool &&
        data.deviceCount is number && data.deviceCount >= 0 && data.deviceCount <= 500 &&
        data.latestReleaseYear is number && data.latestReleaseYear >= 2023 && data.latestReleaseYear <= 2030 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChipset(data) {
      return data.keys().hasAll([
          'id', 'visibility', 'manufacturer', 'name', 'processorModel',
          'cpuArchitecture', 'cpuCores', 'cpuCoreConfig', 'maxClockSpeedGhz',
          'processNodeNm', 'gpuManufacturer', 'gpuModel', 'gpuArchitecture',
          'gpuClockMhz', 'tier', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'visibility', 'manufacturer', 'name', 'processorModel',
          'cpuArchitecture', 'cpuCores', 'cpuCoreConfig', 'maxClockSpeedGhz',
          'processNodeNm', 'gpuManufacturer', 'gpuModel', 'gpuArchitecture',
          'gpuClockMhz', 'tier', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visibility == 'public' &&
        data.manufacturer is string && data.manufacturer.size() >= 1 && data.manufacturer.size() <= 60 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        isNullableString(data.processorModel, 1, 60) &&
        isNullableString(data.cpuArchitecture, 1, 60) &&
        isNullableNumber(data.cpuCores, 1, 16) &&
        isNullableString(data.cpuCoreConfig, 1, 120) &&
        isNullableNumber(data.maxClockSpeedGhz, 0.5, 6.0) &&
        isNullableNumber(data.processNodeNm, 1, 28) &&
        data.gpuManufacturer is string && data.gpuManufacturer.size() >= 1 && data.gpuManufacturer.size() <= 60 &&
        data.gpuModel is string && data.gpuModel.size() >= 1 && data.gpuModel.size() <= 80 &&
        isNullableString(data.gpuArchitecture, 1, 60) &&
        isNullableNumber(data.gpuClockMhz, 100, 2500) &&
        isValidSmartphoneTier(data.tier) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSmartphoneDevice(data) {
      return data.keys().hasAll([
          'id', 'visibility', 'deviceType', 'brandId', 'brand', 'model',
          'modelNumber', 'codename', 'manufacturer', 'os', 'osVersionLaunch',
          'releaseDate', 'releaseYear', 'marketAvailability', 'regionalVariants',
          'tier', 'chipsetId', 'chipsetName', 'gpuModel',
          'ramVariantsGb', 'ramType', 'virtualRamSupport',
          'storageVariantsGb', 'storageType', 'display',
          'batteryMah', 'chargingWatt', 'wirelessChargingWatt',
          'gyroscopeSupport', 'softwareSupportYears',
          'sources', 'verificationStatus', 'completenessStatus',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'visibility', 'deviceType', 'brandId', 'brand', 'model',
          'modelNumber', 'codename', 'manufacturer', 'os', 'osVersionLaunch',
          'releaseDate', 'releaseYear', 'marketAvailability', 'regionalVariants',
          'tier', 'chipsetId', 'chipsetName', 'gpuModel',
          'ramVariantsGb', 'ramType', 'virtualRamSupport',
          'storageVariantsGb', 'storageType', 'display',
          'batteryMah', 'chargingWatt', 'wirelessChargingWatt',
          'gyroscopeSupport', 'softwareSupportYears',
          'sources', 'verificationStatus', 'completenessStatus',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visibility == 'public' &&
        data.deviceType == 'smartphone' &&
        isValidId(data.brandId) &&
        data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60 &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 80 &&
        isNullableString(data.modelNumber, 1, 80) &&
        isNullableString(data.codename, 1, 60) &&
        data.manufacturer is string && data.manufacturer.size() >= 1 && data.manufacturer.size() <= 80 &&
        isValidSmartphoneOs(data.os) &&
        isNullableString(data.osVersionLaunch, 1, 80) &&
        data.releaseDate is string && data.releaseDate.size() == 10 &&
        data.releaseYear is number && data.releaseYear >= 2023 && data.releaseYear <= 2030 &&
        isNullableString(data.marketAvailability, 1, 80) &&
        data.regionalVariants is list && data.regionalVariants.size() <= 10 &&
        (data.regionalVariants.size() == 0 || (data.regionalVariants[0] is string && data.regionalVariants[0].size() <= 80)) &&
        isValidSmartphoneTier(data.tier) &&
        isValidId(data.chipsetId) &&
        data.chipsetName is string && data.chipsetName.size() >= 1 && data.chipsetName.size() <= 80 &&
        data.gpuModel is string && data.gpuModel.size() >= 1 && data.gpuModel.size() <= 80 &&
        data.ramVariantsGb is list && data.ramVariantsGb.size() >= 1 && data.ramVariantsGb.size() <= 8 &&
        data.ramVariantsGb[0] is number &&
        isNullableString(data.ramType, 1, 40) &&
        (data.virtualRamSupport == null || data.virtualRamSupport is bool) &&
        data.storageVariantsGb is list && data.storageVariantsGb.size() >= 1 && data.storageVariantsGb.size() <= 8 &&
        data.storageVariantsGb[0] is number &&
        isNullableString(data.storageType, 1, 40) &&
        isValidDisplayMap(data.display) &&
        isNullableNumber(data.batteryMah, 1500, 12000) &&
        isNullableNumber(data.chargingWatt, 5, 320) &&
        isNullableNumber(data.wirelessChargingWatt, 0, 120) &&
        isValidGyroSupport(data.gyroscopeSupport) &&
        isNullableNumber(data.softwareSupportYears, 0, 10) &&
        data.sources is list && data.sources.size() >= 1 && data.sources.size() <= 5 &&
        isValidSourceEntry(data.sources[0]) &&
        data.verificationStatus in ['verified', 'partial'] &&
        data.completenessStatus in ['complete', 'partial'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGameCompatibility(data) {
      return data.keys().hasAll([
          'id', 'visibility', 'deviceId', 'gameKey', 'supportedFps',
          'maxVerifiedFps', 'graphicsSettings', 'gyroscopeSupport',
          'compatibilityRegion', 'sourceUrl', 'verificationStatus',
          'lastVerifiedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'visibility', 'deviceId', 'gameKey', 'supportedFps',
          'maxVerifiedFps', 'graphicsSettings', 'gyroscopeSupport',
          'compatibilityRegion', 'sourceUrl', 'verificationStatus',
          'lastVerifiedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.visibility == 'public' &&
        isValidId(data.deviceId) &&
        isValidCompatGameKey(data.gameKey) &&
        data.supportedFps is list && data.supportedFps.size() <= 8 &&
        (data.supportedFps.size() == 0 || data.supportedFps[0] is number) &&
        isNullableNumber(data.maxVerifiedFps, 30, 165) &&
        isNullableString(data.graphicsSettings, 1, 120) &&
        isValidGyroSupport(data.gyroscopeSupport) &&
        isNullableString(data.compatibilityRegion, 1, 60) &&
        isNullableString(data.sourceUrl, 1, 300) &&
        data.verificationStatus in ['verified', 'unverified'] &&
        isNullableString(data.lastVerifiedAt, 1, 30) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(userId);

      match /savedSetups/{setupId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(setupId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(setupId) &&
          isOwner(userId) &&
          isValidSavedSetup(incoming()) &&
          incoming().id == setupId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidId(setupId) &&
          isOwner(userId) &&
          isValidSavedSetup(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'game', 'device', 'claw', 'playstyle', 'gyro',
            'preferredFps', 'fireButtonSize', 'dpiOverride', 'cameraPref',
            'currentSensitivity', 'sliders', 'updatedAt'
          ]);
        allow delete: if isVerified() && isValidId(userId) && isValidId(setupId) && (isOwner(userId) || isAdmin());
      }

      match /customDevices/{deviceId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(deviceId) &&
          isOwner(userId) &&
          isValidCustomDevice(incoming()) &&
          incoming().id == deviceId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidId(deviceId) &&
          isOwner(userId) &&
          isValidCustomDevice(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'brand', 'model', 'os', 'chipset', 'ramGb', 'storageGb',
            'screenInches', 'resolution', 'refreshHz', 'touchSamplingHz',
            'tier', 'updatedAt'
          ]);
        allow delete: if isVerified() && isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
      }

      match /aimLabRuns/{runId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(runId) &&
          isOwner(userId) &&
          isValidAimLabRun(incoming()) &&
          incoming().id == runId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerified() && isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin());
      }
    }

    match /presets/{presetId} {
      allow get: if isValidId(presetId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';
      allow create: if isVerified() &&
        isValidId(presetId) &&
        isValidPreset(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().id == presetId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(presetId) &&
        isValidPreset(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'playerArchetype', 'headlineMetric', 'description', 'sliders', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(presetId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /brands/{brandId} {
      allow get: if isValidId(brandId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';
      allow create: if isAdmin() &&
        isValidId(brandId) &&
        isValidBrand(incoming()) &&
        incoming().id == brandId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(brandId) &&
        isValidBrand(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'visibility', 'name', 'parentCompany', 'country', 'isSubBrand',
          'deviceCount', 'latestReleaseYear', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(brandId);
    }

    match /chipsets/{chipsetId} {
      allow get: if isValidId(chipsetId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';
      allow create: if isAdmin() &&
        isValidId(chipsetId) &&
        isValidChipset(incoming()) &&
        incoming().id == chipsetId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(chipsetId) &&
        isValidChipset(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'visibility', 'manufacturer', 'name', 'processorModel',
          'cpuArchitecture', 'cpuCores', 'cpuCoreConfig', 'maxClockSpeedGhz',
          'processNodeNm', 'gpuManufacturer', 'gpuModel', 'gpuArchitecture',
          'gpuClockMhz', 'tier', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(chipsetId);
    }

    match /devices/{deviceId} {
      allow get: if isValidId(deviceId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';
      allow create: if isAdmin() &&
        isValidId(deviceId) &&
        isValidSmartphoneDevice(incoming()) &&
        incoming().id == deviceId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(deviceId) &&
        isValidSmartphoneDevice(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'visibility', 'deviceType', 'brandId', 'brand', 'model',
          'modelNumber', 'codename', 'manufacturer', 'os', 'osVersionLaunch',
          'releaseDate', 'releaseYear', 'marketAvailability', 'regionalVariants',
          'tier', 'chipsetId', 'chipsetName', 'gpuModel',
          'ramVariantsGb', 'ramType', 'virtualRamSupport',
          'storageVariantsGb', 'storageType', 'display',
          'batteryMah', 'chargingWatt', 'wirelessChargingWatt',
          'gyroscopeSupport', 'softwareSupportYears',
          'sources', 'verificationStatus', 'completenessStatus', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(deviceId);
    }

    match /game_compatibility/{compatId} {
      allow get: if isValidId(compatId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';
      allow create: if isAdmin() &&
        isValidId(compatId) &&
        isValidGameCompatibility(incoming()) &&
        incoming().id == compatId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(compatId) &&
        isValidGameCompatibility(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'visibility', 'deviceId', 'gameKey', 'supportedFps',
          'maxVerifiedFps', 'graphicsSettings', 'gyroscopeSupport',
          'compatibilityRegion', 'sourceUrl', 'verificationStatus',
          'lastVerifiedAt', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(compatId);
    }

    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
  }
}
