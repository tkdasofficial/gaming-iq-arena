  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private authenticated player account profile."
    },
    "/users/{userId}/savedSetups/{setupId}": {
      "schema": { "$ref": "#/entities/SavedSetup" },
      "description": "User-owned sensitivity profiles saved to Firestore."
    },
    "/users/{userId}/customDevices/{deviceId}": {
      "schema": { "$ref": "#/entities/CustomDevice" },
      "description": "User-owned custom smartphone hardware specifications."
    },
    "/users/{userId}/aimLabRuns/{runId}": {
      "schema": { "$ref": "#/entities/AimLabRun" },
      "description": "User-owned Aim Lab drill session results."
    },
    "/presets/{presetId}": {
      "schema": { "$ref": "#/entities/CommunityPreset" },
      "description": "Publicly readable non-PII community sensitivity presets authored by verified users."
    },
    "/brands/{brandId}": {
      "schema": { "$ref": "#/entities/Brand" },
      "description": "Publicly readable smartphone manufacturer and sub-brand catalog."
    },
    "/chipsets/{chipsetId}": {
      "schema": { "$ref": "#/entities/Chipset" },
      "description": "Publicly readable SoC CPU/GPU architecture catalog."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/SmartphoneDevice" },
      "description": "Publicly readable verified 2023–2026 smartphone hardware catalog."
    },
    "/game_compatibility/{compatId}": {
      "schema": { "$ref": "#/entities/GameCompatibility" },
      "description": "Publicly readable per-game verified FPS compatibility records."
    }
  }
}
