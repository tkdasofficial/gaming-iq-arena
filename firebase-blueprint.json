{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated Gaming IQ player account profile stored privately under the user document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["player"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "SavedSetup": {
      "title": "SavedSetup",
      "description": "User-saved game sensitivity profile synced to Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "game": {
          "type": "string",
          "enum": ["free-fire", "pubg-bgmi"]
        },
        "device": {
          "type": "object"
        },
        "claw": {
          "type": "string",
          "enum": ["2-finger", "3-finger", "4-finger", "5-finger", "6-finger"]
        },
        "playstyle": {
          "type": "string",
          "enum": [
            "aggressive-rush",
            "headshot-focus",
            "balanced",
            "sniper-focus",
            "aggressive",
            "tactical"
          ]
        },
        "gyro": {
          "type": "string",
          "enum": ["off", "scope-on", "always-on"]
        },
        "preferredFps": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fireButtonSize": {
          "type": "number"
        },
        "dpiOverride": {
          "type": "string",
          "maxLength": 16
        },
        "cameraPref": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "currentSensitivity": {
          "type": "string",
          "maxLength": 160
        },
        "sliders": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "game",
        "device",
        "claw",
        "playstyle",
        "gyro",
        "preferredFps",
        "sliders",
        "createdAt",
        "updatedAt"
      ]
    },
